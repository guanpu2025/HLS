# cp env.sh.example env.sh，按自己的安装路径改。env.sh 不进版本库。
#
# 本仓库不提供 Vivado / Vitis 的安装指导，只负责找到你已经装好的那一份。

# ---------------------------------------------------------------- Vitis HLS

# 注意 2026.1 的目录布局是**版本在前**（早期版本是工具在前）：
#     2026.1      /tools/Xilinx/2026.1/Vitis/settings64.sh
#     2024.2 及更早 /tools/Xilinx/Vitis/2024.2/settings64.sh

# 最常见的写法：source 官方的 settings64.sh
# source /tools/Xilinx/2026.1/Vitis/settings64.sh

# 或者直接把 bin 目录加进 PATH
# export PATH=/tools/Xilinx/2026.1/Vitis/bin:$PATH

# 或者显式指定可执行文件（自动探测失败时用）
# export VITIS_HLS_CMD=/tools/Xilinx/2026.1/Vitis/bin/v++

# 判定需要两个命令：
#   v++         L4 综合判定      v++ -c --mode hls --config ...
#   vitis-run   L2/L3 仿真判定   vitis-run --mode hls --csim --config ...
# 2026.1 没有 vitis_hls 这个二进制了，两个命令分工如上。

# ------------------------------------------------------------------ 授权

# **2026.1 的 HLS 判定需要授权席位**，这一条不配就跑不了 L1 以上。
# 2024.2 及更早在 ZU3EG 上是免授权的，所以老教程里没有这一节。
# export XILINXD_LICENSE_FILE=2100@your-license-server

# 席位签不出时的症状是**静默的**：工具照常退出 0，日志里没有任何
# "license" 字样，只是该有的结果没出现。判定器会把这种情况判成
# LICENSE_ERROR 而不是算你代码的错（见 selftest/judge/来源.md），
# 但前提是你得知道要去看这一行。

# ------------------------------------------------------------------ LLM 后端

# 桩模式：不联网、不要 key，只验证链路
export LLM_BACKEND=mock

# 开发调试：任意 OpenAI 兼容的商用 API
# export LLM_BACKEND=openai
# export LLM_BASE_URL=https://api.deepseek.com/v1
# export LLM_API_KEY=sk-xxxxxxxx
# export LLM_MODEL=deepseek-coder

# 正式提交必须是这一种：本地部署的开源权重
# export LLM_BACKEND=openai
# export LLM_BASE_URL=http://localhost:8000/v1
# export LLM_API_KEY=dummy
# export LLM_MODEL=Qwen3-8B

# -------------------------------------------------------------------- 其它

# 临时目录，必须是本地盘。指向 NFS 时综合会慢一个数量级
# export AGENT_TMP=/tmp
# export SELFTEST_TMP=/tmp

# 保留判定的工作目录，排查问题时用
# export SELFTEST_KEEP_WORK=1

# 增益项满分线，占位值，以赛前公告为准
# export GAIN_FULL_MARK=2.5
